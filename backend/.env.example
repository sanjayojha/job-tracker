APP_NAME="Job Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://job-tracker.ddev.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- SPA authentication (Sanctum) ---
# The SPA runs on a different port to the API, which makes it a separate
# origin for CORS but the SAME host for cookies (cookies ignore port).
FRONTEND_URL=https://job-tracker.ddev.site:5173
# Must include the port, or Sanctum will not treat SPA requests as stateful.
SANCTUM_STATEFUL_DOMAINS=job-tracker.ddev.site:5173,job-tracker.ddev.site
# SESSION_DOMAIN stays null above: a host-only cookie is already sent to both
# ports, and ddev.site is a public suffix so a .ddev.site cookie is rejected.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="dev@job-tracker.test"
MAIL_FROM_NAME="${APP_NAME}"

# The only third-party credentials this project needs. Not required for MVP --
# leave blank until V1 adds file attachments (S3) and, in production, SES mail.
# Local dev uses the `local` disk and DDEV's Mailpit, neither of which needs a key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
